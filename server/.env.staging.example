# STAGING ortami - roadmap AŞAMA 34: production'a gecmeden once ayri bir
# Supabase projesi + ayri LiveKit projesi kullanilmali (development'taki
# ile AYNI degerler buraya KOPYALANMAMALI - staging kendi izole verisine
# sahip olmali, gercek kullanici verisiyle karismamali).
PORT=3000
NODE_ENV=staging

# Supabase Dashboard'da AYRI bir "luna-staging" projesi olusturup oradan al.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# LiveKit Cloud'da AYRI bir staging projesi/API key seti kullan.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
