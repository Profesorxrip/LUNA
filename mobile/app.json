{
  "expo": {
    "name": "LUNA",
    "slug": "luna",
    "version": "1.0.0",
    "scheme": "luna",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.luna.app"
    },
    "android": {
      "package": "com.luna.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LUNA, oda içindeki haritada konumunu diğer katılımcılara göstermek için konumuna ihtiyaç duyuyor. İstersen Ayarlar'dan Konumu Gizle'yi açabilirsin."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "LUNA, indirdiğin fotoğrafları galerine kaydetmek için fotoğraflarına erişim izni istiyor."
        }
      ]
    ]
  }
}
